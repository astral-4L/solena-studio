# Public, build-time values (safe to commit to your host's env UI).
# These are baked into the client bundle at build time.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Server-side equivalents (used during SSR / server functions).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Deployment target. One of: node-server | static | vercel | cloudflare-module
NITRO_PRESET=node-server
